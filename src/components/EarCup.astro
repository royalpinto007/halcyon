---
const { size = 'w-[78%] max-w-md' } = Astro.props
---
<div class={`relative aspect-square ${size} rounded-full`} style="background: radial-gradient(circle at 34% 28%, #f0eadd, #d3cab8 38%, #928779 72%, #5f564a); box-shadow: 0 50px 90px -25px rgba(28,23,18,0.45), inset 0 3px 8px rgba(255,255,255,0.45);">
  <div class="absolute inset-[13%] rounded-full" style="background: radial-gradient(circle at 40% 34%, #3b352e, #1a1610); box-shadow: inset 0 6px 26px rgba(0,0,0,0.65);"></div>
  <div class="absolute inset-[29%] rounded-full border-2" style="border-color: color-mix(in srgb, var(--color-copper) 70%, transparent);"></div>
  <div class="absolute inset-[43%] rounded-full" style="background: radial-gradient(circle at 45% 40%, #55493c, #241d15);"></div>
</div>
