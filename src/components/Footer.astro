---
const cols = [
  { h: 'Explore', links: [['The One','/product'],['Technology','/technology'],['Craft','/craft'],['Buy','/buy']] },
  { h: 'Support', links: [['Warranty','#'],['Care','#'],['Contact','#'],['Returns','#']] },
  { h: 'Halcyon', links: [['Story','/craft'],['Press','#'],['Stockists','#']] },
]
---
<footer class="border-t border-[var(--color-line)] bg-[var(--color-paper-2)]">
  <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <a href="/" class="font-display text-2xl font-semibold tracking-tight">Halcyon</a>
        <p class="mt-3 max-w-xs text-sm text-[var(--color-ink-soft)]">Reference-grade headphones, made in small batches.</p>
      </div>
      {cols.map((c) => (
        <div>
          <h4 class="font-display text-sm font-semibold">{c.h}</h4>
          <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-soft)]">
            {c.links.map(([l, h]) => <li><a class="hover:text-[var(--color-ink)]" href={h}>{l}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-14 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-ink-soft)]">
      © 2026 Halcyon Audio (concept) · A demo site by Royal Simpson Pinto · Built with Astro & Tailwind
    </p>
  </div>
</footer>
