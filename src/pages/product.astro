---
import Base from '../layouts/Base.astro'
import EarCup from '../components/EarCup.astro'
import { FEATURES, SPECS } from '../data/product'
---
<Base path="/product" title="The Halcyon One — Halcyon" description="Everything about the Halcyon One: driver, materials, isolation, and full specifications.">
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-40 pb-16 sm:pt-52 md:grid-cols-2 lg:px-8">
    <div>
      <p class="anim-rise text-sm uppercase tracking-[0.3em] text-[var(--color-copper)]">The Halcyon One</p>
      <h1 class="anim-rise mt-5 font-display text-5xl font-light leading-[1.02] tracking-tight sm:text-6xl" style="animation-delay:.1s">One pair. Made to outlast the trend cycle.</h1>
      <p class="anim-rise mt-6 max-w-md text-lg text-[var(--color-ink-soft)]" style="animation-delay:.2s">No app. No firmware. No battery to die in three years. Just a driver, a chassis, and a tuning we stand behind for five.</p>
    </div>
    <div class="anim-rise flex justify-center" style="animation-delay:.3s"><EarCup size="w-[80%] max-w-md" /></div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {FEATURES.map((f, i) => (
        <div class="reveal rounded-3xl border border-[var(--color-line)] bg-[var(--color-paper-2)]/60 p-8" data-d={String((i % 3) + 1)}>
          <p class="text-xs uppercase tracking-[0.25em] text-[var(--color-copper)]">{f.k}</p>
          <h2 class="mt-3 font-display text-2xl font-light tracking-tight">{f.title}</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-4xl px-6 py-24 lg:px-8">
      <h2 class="reveal font-display text-3xl font-light tracking-tight">Specifications</h2>
      <dl class="reveal mt-8 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
        {SPECS.map(([k, v]) => (
          <div class="flex items-baseline justify-between py-4">
            <dt class="text-[var(--color-ink-soft)]">{k}</dt>
            <dd class="font-display text-lg">{v}</dd>
          </div>
        ))}
      </dl>
      <a href="/buy" class="reveal mt-10 inline-block rounded-full bg-[var(--color-ink)] px-8 py-3 font-semibold text-[var(--color-paper)] transition hover:bg-[var(--color-copper)]">Buy — $690</a>
    </div>
  </section>
</Base>
