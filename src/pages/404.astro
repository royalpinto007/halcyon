---
import Base from '../layouts/Base.astro'
---
<Base path="/404" title="Not found — Halcyon">
  <section class="mx-auto flex min-h-[75vh] max-w-3xl flex-col items-center justify-center px-6 text-center">
    <p class="anim-rise font-display text-8xl font-light text-[var(--color-copper)] sm:text-9xl">404</p>
    <h1 class="anim-rise mt-4 font-display text-3xl font-light" style="animation-delay:.08s">This page is out of earshot.</h1>
    <a href="/" class="anim-rise mt-8 rounded-full bg-[var(--color-ink)] px-8 py-3 font-semibold text-[var(--color-paper)]" style="animation-delay:.14s">Back home</a>
  </section>
</Base>
